    },
    {
      "text": "[carefully] Ravintola.",
      "voice_id": "vnJXCu1mkdsxb9UdCYZp",
      "lang": "fi"
    },
    {
      "text": "Even a long word. Orange.",
      "voice_id": "nJ8YqEenIxs18T0Hu4QE",
      "lang": "en"
    },
    {
      "text": "[slowly] Appelsiini.",
